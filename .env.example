# Add altman_zscore to PYTHONPATH for module compatibility
PYTHONPATH=altman_zscore

# Altman Z-Score Project Environment Variables v4.0.0
# SEC EDGAR User-Agent format: AppName/Version ContactEmail
SEC_EDGAR_USER_AGENT=AltmanZScore/4.0.0 your-email@example.com Purpose=Altman_Z-Score_Analysis
SEC_API_EMAIL=your-email@example.com

# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_BASE_URL=https://your-openai-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_MODEL=your-model-name

# Finnhub API Configuration
FINNHUB_API_KEY="your-finnhub-api-key-here"

# Financial Modeling Prep API Key (for validation and benchmarking)
FINANCIAL_MODELING_PREP_API_KEY="your-fmp-api-key-here"

# Yahoo Finance User Agent (for responsible API usage)
YAHOO_FINANCE_USER_AGENT="AltmanZScore/4.0.0 your-email@example.com"

# Enhanced Analysis Configuration
# Choose configuration based on your FMP account type:

# === FOR FREE FMP ACCOUNTS ===
# Recommended settings for free accounts (limited API calls)
# FMP_ENHANCED_MODE=0
# YAHOO_ENHANCED_MODE=0
# DEFAULT_QUARTERS=4  # Limited historical analysis
# MAX_BATCH_SIZE=5    # Smaller batch processing
# CACHE_TTL_HOURS=48  # Longer cache to reduce API calls
# ENABLE_PEER_COMPARISON=0
# ENABLE_INDUSTRY_BENCHMARKS=0
# ENABLE_QUARTERLY_TRENDS=0
# ENABLE_SEASONALITY_ANALYSIS=0
# CONCURRENT_REQUESTS=2  # Lower concurrent processing
# API_RATE_LIMIT_PER_MINUTE=60  # Conservative rate limiting
# GENERATE_QUARTERLY_REPORTS=0
# GENERATE_COMPARATIVE_CHARTS=0
# GENERATE_PORTFOLIO_SUMMARY=0

# === FOR PAID/UPGRADED FMP ACCOUNTS ===
# Optimized settings for multi-quarter analysis and large portfolio processing

# API Enhanced Mode Configuration
FMP_ENHANCED_MODE=1
YAHOO_ENHANCED_MODE=1

# Analysis Configuration
DEFAULT_QUARTERS=8  # Extended historical analysis
MAX_BATCH_SIZE=25   # Larger batch processing
CACHE_TTL_HOURS=24  # Shorter cache for more up-to-date data

# Enhanced Features
ENABLE_PEER_COMPARISON=1
ENABLE_INDUSTRY_BENCHMARKS=1
ENABLE_QUARTERLY_TRENDS=1
ENABLE_SEASONALITY_ANALYSIS=1

# Performance Optimization
CONCURRENT_REQUESTS=10  # Higher concurrent processing
API_RATE_LIMIT_PER_MINUTE=300  # Adjusted for upgraded limits

# Output Configuration
GENERATE_QUARTERLY_REPORTS=1
GENERATE_COMPARATIVE_CHARTS=1
GENERATE_PORTFOLIO_SUMMARY=1

# Logging
LOG_LEVEL=INFO
ENHANCED_LOGGING=1
