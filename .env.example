# =================================================================
# Altman Z-Score Project Environment Variables v4.3.1 - EXAMPLE
# =================================================================
# 
# Copy this file to .env and fill in your actual values.
# Variables are marked as:
# - ACTIVE: Currently implemented and used by the codebase
# - NOT IMPLEMENTED YET: Documented but not yet implemented
# - FUTURE: Planned for future releases
#
# Choose configuration based on your account types (free vs paid APIs)
# =================================================================

# Add altman_zscore to PYTHONPATH for module compatibility
PYTHONPATH=altman_zscore

# =================================================================
# API CREDENTIALS (ACTIVE - Required for data source modules)
# =================================================================

# SEC EDGAR Configuration (LEGACY - No longer used in current pipeline)
# SEC_EDGAR_USER_AGENT=AltmanZScore/4.3.1 your-email@example.com Purpose=Altman_Z-Score_Analysis
# SEC_API_EMAIL=your-email@example.com

# Azure OpenAI Configuration (ACTIVE - Used by ai_narrative.py)
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_BASE_URL=https://your-openai-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_MODEL=your-model-name

# =================================================================
# LLM CONFIGURATION (ACTIVE - Used by all LLM client methods)
# =================================================================

# LLM Temperature Settings (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE_INSIGHTS=0.7
LLM_TEMPERATURE_NARRATIVE=0.8
LLM_TEMPERATURE_ANALYSIS=0.5

# LLM Token Limits (maximum tokens for responses)
LLM_MAX_TOKENS_INSIGHTS=2000
LLM_MAX_TOKENS_NARRATIVE=1500
LLM_MAX_TOKENS_ANALYSIS=1000

# Finnhub API Configuration (ACTIVE - Used by finnhub_data.py)
FINNHUB_API_KEY="your-finnhub-api-key-here"

# Financial Modeling Prep API Key (ACTIVE - Used by fmp_data.py)
FINANCIAL_MODELING_PREP_API_KEY="your-fmp-api-key-here"

# Yahoo Finance User Agent (ACTIVE - Used by yahoo_data.py)
YAHOO_FINANCE_USER_AGENT="AltmanZScore/4.3.1 your-email@example.com"

# =================================================================
# CONFIGURATION BY ACCOUNT TYPE
# =================================================================

# Choose configuration based on your FMP account type:

# === FOR FREE FMP ACCOUNTS ===
# Recommended settings for free accounts (limited API calls)
# FMP_ENHANCED_MODE=0
# YAHOO_ENHANCED_MODE=0
# DEFAULT_QUARTERS=4
# MAX_BATCH_SIZE=5
# CACHE_TTL_HOURS=48
# FINANCIAL_CACHE_TTL_DAYS=7
# ENABLE_PEER_COMPARISON=0
# ENABLE_INDUSTRY_BENCHMARKS=0
# ENABLE_QUARTERLY_TRENDS=0
# ENABLE_SEASONALITY_ANALYSIS=0
# FMP_REQUESTS_PER_SECOND=2.0
# GENERATE_QUARTERLY_REPORTS=0
# GENERATE_COMPARATIVE_CHARTS=0
# GENERATE_PORTFOLIO_SUMMARY=0
# LOG_LEVEL=WARNING
# FMP_DATA_PERIOD=annual

# === FOR PAID/UPGRADED FMP ACCOUNTS ===
# Optimized settings for multi-quarter analysis and large portfolio processing
# (These are the current active defaults optimized for modern systems)

# =================================================================
# ENHANCED MODE CONFIGURATION
# =================================================================

# API Enhanced Mode Configuration
FMP_ENHANCED_MODE=1
YAHOO_ENHANCED_MODE=1

# =================================================================
# ANALYSIS CONFIGURATION (ACTIVE - Used by main.py and config.py)
# =================================================================

# Modern defaults optimized for current systems (v4.3.1)
DEFAULT_QUARTERS=12
MAX_BATCH_SIZE=25
CACHE_TTL_HOURS=24

# =================================================================
# CACHE CONFIGURATION (ACTIVE - Used by config.py and cache modules)
# =================================================================

CACHE_DIR=.cache
FINANCIAL_CACHE_TTL_DAYS=2
CIK_CACHE_TTL_DAYS=30
ENABLE_CACHE=true

# =================================================================
# ENHANCED FEATURES (NOT IMPLEMENTED YET - Future releases)
# =================================================================

ENABLE_PEER_COMPARISON=1
ENABLE_INDUSTRY_BENCHMARKS=1
ENABLE_QUARTERLY_TRENDS=1
ENABLE_SEASONALITY_ANALYSIS=1

# =================================================================
# RATE LIMITING (ACTIVE - Used by config.py and api_rate_limiter.py)
# =================================================================

SEC_REQUESTS_PER_SECOND=10.0
YAHOO_REQUESTS_PER_SECOND=2.0
FINNHUB_REQUESTS_PER_SECOND=1.0
FMP_REQUESTS_PER_SECOND=5.0
OPENAI_REQUESTS_PER_SECOND=1.0
MAX_BACKOFF_SECONDS=64

# =================================================================
# OUTPUT CONFIGURATION - Advanced Reports (NOT IMPLEMENTED YET)
# =================================================================

GENERATE_QUARTERLY_REPORTS=1
GENERATE_COMPARATIVE_CHARTS=1
GENERATE_PORTFOLIO_SUMMARY=1

# =================================================================
# OUTPUT CONFIGURATION - Basic (ACTIVE - Used by config.py)
# =================================================================

OUTPUT_DIR=output
GENERATE_CSV=true
GENERATE_JSON=true
GENERATE_CHARTS=true
GENERATE_REPORTS=true
CHART_WIDTH=1200
CHART_HEIGHT=800

# =================================================================
# LOGGING (ACTIVE - Used by logging_config.py)
# =================================================================

LOG_LEVEL=INFO
LOG_CONSOLE_LEVEL=INFO
LOG_FILE_LEVEL=DEBUG
LOG_DIR=logs
LOG_STRUCTURED=false
ENHANCED_LOGGING=1
SHOW_PROGRESS_BARS=auto

# =================================================================
# ENVIRONMENT & DEBUGGING (ACTIVE - Used by config.py)
# =================================================================

ENVIRONMENT=development
DEBUG=false

# =================================================================
# ADVANCED CONFIGURATION (ACTIVE - Used by config.py)
# =================================================================

ENABLE_REALITY_CHECKS=true
MAX_OUTLIER_THRESHOLD=5.0
DEFAULT_MODEL=original
DEFAULT_START_DATE=2018-01-01
MINIMUM_QUARTERS_REQUIRED=4
FMP_DATA_PERIOD=quarter
