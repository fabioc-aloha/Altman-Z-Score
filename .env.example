# =================================================================
# Altman Z-Score Project Environment Variables v4.0.1 - EXAMPLE
# =================================================================
# 
# Copy this file to .env and fill in your actual values.
# Variables are marked as:
# - ACTIVE: Currently implemented and used by the codebase
# - NOT IMPLEMENTED YET: Documented but not yet implemented
# - FUTURE: Planned for future releases
#
# Choose configuration based on your account types (free vs paid APIs)
# =================================================================

# Add altman_zscore to PYTHONPATH for module compatibility
PYTHONPATH=altman_zscore

# =================================================================
# API CREDENTIALS (ACTIVE - Required for data source modules)
# =================================================================

# SEC EDGAR Configuration (LEGACY - No longer used in current pipeline)
# SEC_EDGAR_USER_AGENT=AltmanZScore/4.0.0 your-email@example.com Purpose=Altman_Z-Score_Analysis
# SEC_API_EMAIL=your-email@example.com

# Azure OpenAI Configuration (ACTIVE - Used by ai_narrative.py)
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_BASE_URL=https://your-openai-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_MODEL=your-model-name

# Finnhub API Configuration (ACTIVE - Used by finnhub_data.py)
FINNHUB_API_KEY="your-finnhub-api-key-here"

# Financial Modeling Prep API Key (ACTIVE - Used by fmp_data.py)
FINANCIAL_MODELING_PREP_API_KEY="your-fmp-api-key-here"

# Yahoo Finance User Agent (ACTIVE - Used by yahoo_data.py)
YAHOO_FINANCE_USER_AGENT="AltmanZScore/4.0.0 your-email@example.com"

# =================================================================
# CONFIGURATION BY ACCOUNT TYPE
# =================================================================

# Choose configuration based on your FMP account type:

# === FOR FREE FMP ACCOUNTS ===
# Recommended settings for free accounts (limited API calls)
# FMP_ENHANCED_MODE=0                    # ACTIVE - Disable enhanced features
# YAHOO_ENHANCED_MODE=0                  # NOT IMPLEMENTED YET - Keep disabled
# DEFAULT_QUARTERS=4                     # ACTIVE - Limited historical analysis
# MAX_BATCH_SIZE=5                       # ACTIVE - Smaller batch processing
# CACHE_TTL_HOURS=48                     # ACTIVE - Longer cache to reduce API calls
# FINANCIAL_CACHE_TTL_DAYS=7             # ACTIVE - Longer cache for free accounts
# ENABLE_PEER_COMPARISON=0               # NOT IMPLEMENTED YET - Keep disabled
# ENABLE_INDUSTRY_BENCHMARKS=0           # NOT IMPLEMENTED YET - Keep disabled
# ENABLE_QUARTERLY_TRENDS=0              # NOT IMPLEMENTED YET - Keep disabled
# ENABLE_SEASONALITY_ANALYSIS=0          # NOT IMPLEMENTED YET - Keep disabled
# FMP_REQUESTS_PER_SECOND=2.0            # ACTIVE - Conservative rate for free accounts
# GENERATE_QUARTERLY_REPORTS=0           # NOT IMPLEMENTED YET - Keep disabled
# GENERATE_COMPARATIVE_CHARTS=0          # NOT IMPLEMENTED YET - Keep disabled
# GENERATE_PORTFOLIO_SUMMARY=0           # NOT IMPLEMENTED YET - Keep disabled
# LOG_LEVEL=WARNING                      # ACTIVE - Less verbose logging for free accounts
# FMP_DATA_PERIOD=annual                 # ACTIVE - Annual data only for free accounts

# === FOR PAID/UPGRADED FMP ACCOUNTS ===
# Optimized settings for multi-quarter analysis and large portfolio processing

# =================================================================
# ENHANCED MODE CONFIGURATION
# =================================================================

# API Enhanced Mode Configuration
FMP_ENHANCED_MODE=1                     # ACTIVE - Enable enhanced FMP features
YAHOO_ENHANCED_MODE=1                   # NOT IMPLEMENTED YET - Planned for enhanced Yahoo data

# =================================================================
# ANALYSIS CONFIGURATION (ACTIVE - Used by main.py and config.py)
# =================================================================

DEFAULT_QUARTERS=8                      # ACTIVE - Extended historical analysis
MAX_BATCH_SIZE=25                       # ACTIVE - Larger batch processing
CACHE_TTL_HOURS=24                      # ACTIVE - Shorter cache for more up-to-date data

# =================================================================
# CACHE CONFIGURATION (ACTIVE - Used by config.py and cache modules)
# =================================================================

CACHE_DIR=.cache                        # ACTIVE - Cache directory path
FINANCIAL_CACHE_TTL_DAYS=2              # ACTIVE - Financial data cache TTL in days
CIK_CACHE_TTL_DAYS=30                   # ACTIVE - CIK mappings cache TTL in days
ENABLE_CACHE=true                       # ACTIVE - Global cache toggle

# =================================================================
# ENHANCED FEATURES (NOT IMPLEMENTED YET - Future releases)
# =================================================================

ENABLE_PEER_COMPARISON=1                # NOT IMPLEMENTED YET - Peer company analysis
ENABLE_INDUSTRY_BENCHMARKS=1            # NOT IMPLEMENTED YET - Industry benchmark comparisons
ENABLE_QUARTERLY_TRENDS=1               # NOT IMPLEMENTED YET - Quarterly trend analysis
ENABLE_SEASONALITY_ANALYSIS=1           # NOT IMPLEMENTED YET - Seasonal pattern analysis

# =================================================================
# RATE LIMITING (ACTIVE - Used by config.py and api_rate_limiter.py)
# =================================================================

SEC_REQUESTS_PER_SECOND=10.0            # ACTIVE - SEC EDGAR requests per second
YAHOO_REQUESTS_PER_SECOND=2.0           # ACTIVE - Yahoo Finance requests per second
FINNHUB_REQUESTS_PER_SECOND=1.0         # ACTIVE - Finnhub requests per second
FMP_REQUESTS_PER_SECOND=5.0             # ACTIVE - FMP requests per second (upgraded account)
OPENAI_REQUESTS_PER_SECOND=1.0          # ACTIVE - OpenAI requests per second
MAX_BACKOFF_SECONDS=64                  # ACTIVE - Maximum backoff time for rate limiting

# =================================================================
# OUTPUT CONFIGURATION - Advanced Reports (NOT IMPLEMENTED YET)
# =================================================================

GENERATE_QUARTERLY_REPORTS=1            # NOT IMPLEMENTED YET - Quarterly report generation
GENERATE_COMPARATIVE_CHARTS=1           # NOT IMPLEMENTED YET - Comparative chart generation
GENERATE_PORTFOLIO_SUMMARY=1            # NOT IMPLEMENTED YET - Portfolio summary reports

# =================================================================
# OUTPUT CONFIGURATION - Basic (ACTIVE - Used by config.py)
# =================================================================

OUTPUT_DIR=output                       # ACTIVE - Output directory for reports
GENERATE_CSV=true                       # ACTIVE - Generate CSV output
GENERATE_JSON=true                      # ACTIVE - Generate JSON output
GENERATE_CHARTS=true                    # ACTIVE - Generate chart visualizations
GENERATE_REPORTS=true                   # ACTIVE - Generate HTML reports
CHART_WIDTH=1200                        # ACTIVE - Chart width in pixels
CHART_HEIGHT=800                        # ACTIVE - Chart height in pixels

# =================================================================
# LOGGING (ACTIVE - Used by logging_config.py)
# =================================================================

LOG_LEVEL=INFO                          # ACTIVE - Default log level
LOG_CONSOLE_LEVEL=INFO                  # ACTIVE - Separate console logging level
LOG_FILE_LEVEL=DEBUG                    # ACTIVE - File logging level for detailed debugging
LOG_DIR=logs                            # ACTIVE - Directory for log files
LOG_STRUCTURED=false                    # ACTIVE - Enable structured JSON logging
ENHANCED_LOGGING=1                      # ACTIVE - Enhanced logging features
SHOW_PROGRESS_BARS=auto                 # ACTIVE - Show progress bars: auto (quiet modes), always, never

# =================================================================
# ENVIRONMENT & DEBUGGING (ACTIVE - Used by config.py)
# =================================================================

ENVIRONMENT=development                 # ACTIVE - Environment: development, production, test
DEBUG=false                             # ACTIVE - Enable debug mode

# =================================================================
# ADVANCED CONFIGURATION (ACTIVE - Used by config.py)
# =================================================================

ENABLE_REALITY_CHECKS=true              # ACTIVE - Enable data validation checks
MAX_OUTLIER_THRESHOLD=5.0               # ACTIVE - Maximum outlier threshold for data validation
DEFAULT_MODEL=original                  # ACTIVE - Default Z-Score model
DEFAULT_START_DATE=2018-01-01           # ACTIVE - Default start date for analysis
MINIMUM_QUARTERS_REQUIRED=4             # ACTIVE - Minimum quarters required for analysis
FMP_DATA_PERIOD=quarter                 # ACTIVE - "annual" or "quarter" (use quarter for paid accounts)
